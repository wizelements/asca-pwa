{
  "name": "asca-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:e2e": "playwright test",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "test:api": "node --experimental-strip-types --import ./tests/register.mjs tests/gallery/api.test.mjs",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit push --config=drizzle.config.ts",
    "db:migrate-media": "node scripts/migrate-inline-images.js"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@headlessui/react": "^1.7.17",
    "@libsql/client": "^0.14.0",
    "clsx": "^2.0.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-kit": "^0.27.1",
    "firebase": "^10.6.0",
    "framer-motion": "^10.16.0",
    "jose": "^5.4.0",
    "next-seo": "^6.2.0",
    "react-hook-form": "^7.48.0",
    "resend": "^2.0.0",
    "swr": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
}
